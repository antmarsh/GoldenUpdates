<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="GoldenEndPoint" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://golden-clinic.net/GoldenSrv.svc" binding="basicHttpBinding" bindingConfiguration="GoldenEndPoint" contract="GoldenSrv.IGoldenSrv" name="GoldenEndPoint" />
    </client>
    <services>
      <service name="GoldenToMobileService.GoldenToMobileService" behaviorConfiguration="mexBehavior">
        <endpoint address="GoldenToMobileService" binding="basicHttpBinding" contract="GoldenToMobileService.IGoldenToMobileService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8899/GoldenToMobile/" />
          </baseAddresses>
        </host>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
